{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src",
    "docs",
    "blog",
    "*.ts",
    "*.tsx",
    "docusaurus.config.ts",
    "sidebars.ts",
    "postcss.config.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".docusaurus",
    "dist",
    "tailwind.config.js",
    "postcss.config.js"
  ]
}
